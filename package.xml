<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<package format="1" xmlns="https://wiki.freecad.org/Package_Metadata">
    <name>OpenSKP Import/Export</name>
    <description>Native SketchUp (.skp) import and export for FreeCAD, built on OpenSKP - no Trimble SDK, no SketchUp installation required.</description>
    <version>0.2.5</version>
    <date>2026-09-18</date>
    <maintainer email="mail.ahsanmehmood@gmail.com">Ahsan Mehmood</maintainer>
    <license file="LICENSE">MIT</license>
    <url type="repository" branch="main">https://github.com/iamahsanmehmood/freecad-openskp</url>
    <url type="bugtracker">https://github.com/iamahsanmehmood/freecad-openskp/issues</url>
    <url type="readme">https://github.com/iamahsanmehmood/freecad-openskp/blob/main/README.md</url>
    <icon>icon.png</icon>

    <!-- "other" content type below requires FreeCAD 1.1+ (see comment
    there); on older FreeCAD this <content> block would just be silently
    ignored (unrecognized elements are ignored, not errors), so users on
    versions before 1.1 simply won't see this addon listed at all. -->
    <freecadmin>1.1.0</freecadmin>

    <content>
        <!-- "other" (FreeCAD 1.1+), not "workbench" - this addon has no
        GUI/toolbar, it only registers the .skp import/export file types
        via Init.py. "workbench" requires a <classname> matching a real
        InitGui class, which doesn't apply here. -->
        <other>
            <name>OpenSKPImporter</name>
            <subdirectory>./</subdirectory>
        </other>
    </content>
</package>
